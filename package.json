{
  "name": "ds-saver",
  "version": "0.2.1",
  "description": "Context and token saver for DeepSeek workflows on OpenCode and DeepSeek Harness (DSH)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T1113047/ds-saver.git"
  },
  "homepage": "https://github.com/T1113047/ds-saver#readme",
  "bugs": {
    "url": "https://github.com/T1113047/ds-saver/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./dsh": "./dsh/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "dsh",
    "cordis.patch.yml",
    "install.sh",
    "scripts",
    "docs",
    "data",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context",
    "token",
    "handoff"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "check": "node --check index.js && node --check dsh/index.js && node --check test/smoke.mjs"
  }
}

